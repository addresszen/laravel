{
    "name": "addresszen/laravel",
    "description": "Laravel package for the AddressZen PHP SDK: set your API key in .env, then inject the client or call the facade",
    "type": "library",
    "keywords": [
        "addresszen",
        "laravel",
        "address",
        "address verification",
        "address autocomplete"
    ],
    "homepage": "https://addresszen.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "AddressZen",
            "email": "support@addresszen.com",
            "homepage": "https://addresszen.com"
        }
    ],
    "support": {
        "email": "support@addresszen.com",
        "docs": "https://docs.addresszen.com/docs/sdks/php/laravel",
        "issues": "https://github.com/addresszen/feedback/issues"
    },
    "require": {
        "php": "^8.2",
        "addresszen/sdk": "^0.1",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {
                "versions": {
                    "addresszen/sdk": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "AddressZen\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AddressZen\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AddressZen\\Laravel\\AddressZenServiceProvider"
            ],
            "aliases": {
                "AddressZen": "AddressZen\\Laravel\\Facades\\AddressZen"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "test:types": [
            "phpstan analyse --memory-limit=512M",
            "phpstan analyse --memory-limit=512M -c phpstan.tests.neon.dist"
        ],
        "test:unit": "pest --colors=always",
        "test": [
            "@lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
